# Copy to `.env` and fill in.

# --- Database -----------------------------------------------------------
# Local docker-compose default. Change if running Postgres outside compose.
DATABASE_URL="postgresql://garage:garage@localhost:5432/garage?schema=public"

# --- Server -------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Auth ---------------------------------------------------------------
# Generate strong secrets for prod with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Storage ------------------------------------------------------------
# Local filesystem in dev; switch to S3/MinIO in prod (not yet implemented).
UPLOADS_DIR=./uploads

# --- Google Cloud Vision (OCR) ------------------------------------------
# Path to a service account JSON file with Vision API enabled.
# Leave empty to skip Vision setup; OCR will only work with DEMO_MODE=true.
GOOGLE_APPLICATION_CREDENTIALS=

# --- LLM (Gemini) -------------------------------------------------------
# Used for: receipt field parsing (replaces regex), AI-phrased service
# reminders, and the "explain this prediction" modal. Free tier is enough
# for v1 (1M tokens/day, 15 req/min). See spec §16.
LLM_PROVIDER=gemini                  # gemini | openai | anthropic (only gemini implemented)
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=8000                  # hard timeout per call

# --- Demo mode ----------------------------------------------------------
# When "true", the OCR endpoint skips Google Vision AND the LLM, returning
# hardcoded plausible fields. Reminder AI messages and predict explainers
# also use template strings instead of LLM calls. ALWAYS true for the live demo.
DEMO_MODE=false
