<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
        Cleartext HTTP is enabled ONLY for debug builds so the dev flow
        (adb reverse → http://localhost:3000, or a LAN-IP backend) works.
        Release builds use the main manifest (HTTPS-only) — this attribute
        is intentionally absent there. Caught by the 2026-05-24 security
        audit; the main manifest previously had usesCleartextTraffic=true
        globally, which defeats TLS in release builds.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
